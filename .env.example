# Who may sign in (comma-separated Google emails)
ALLOWED_EMAILS=you@gmail.com,andrew@gmail.com
# Long random string used to sign login cookies:  openssl rand -hex 32
SESSION_SECRET=change-me
# Google OAuth (Google Cloud Console > Credentials > OAuth client ID, type "Web application")
# Redirect URI: http://localhost:4321/auth/callback  (add your Vercel URL later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-only shortcut: set to 1 to sign in without Google while developing
AUTH_DEV=1

# Plaid (dashboard.plaid.com > Developers > Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" = fake banks, free, unlimited.  "production" = real banks, a fixed number of logins on the Trial plan.
PLAID_ENV=sandbox
# Needed for real banks only (Bank of America, Wells Fargo, Capital One, Citi all use it).
# Must be https and also be added in the Plaid dashboard under Developers > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=
# Hard stop on real bank logins. Set this to the limit your Plaid dashboard shows for your Trial plan.
# Removing a bank later does NOT give the slot back.
PLAID_ITEM_CAP=20

# Key that encrypts bank access tokens before they are stored:  openssl rand -hex 32
TOKEN_KEY=

# Postgres (Neon) connection string. Leave empty locally: data is kept in ./data instead.
DATABASE_URL=

# Lets Vercel's daily job refresh your data. Set on Vercel only:  openssl rand -hex 32
CRON_SECRET=
